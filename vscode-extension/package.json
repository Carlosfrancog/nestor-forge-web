{
  "name": "nestor-forge-agent-orchestra",
  "displayName": "Agent Orchestra (Nestor Forge)",
  "description": "Explore agentes e skills, mapeie o projeto e gere contexto para documentação.",
  "version": "0.5.7",
  "publisher": "CarlosEFranco",
  "icon": "media/agents.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:agentOrchestra.files"
  ],
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check src/catalog.js && node --check src/extension.js && node --check src/forge.js && node --check src/activity.js && node --check src/dashboard.js && node --check src/agentRuns.js && node --check src/updates.js && node --check src/share.js && node --check src/python.js && node --check src/structural.js && node --check src/diffAst.js && node --check src/projectMap.js && node --check src/projectMapView.js && node --check src/projectMapRunner.js && node --check src/projectMapWorker.js && node --check src/projectDocs.js && node --check src/projectDocumentationAgent.js && node --check scripts/diff-ast.js && node --check backend/activity-hook.js",
    "vscode:prepublish": "python ../scripts/bundle_extension_backend.py"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentOrchestra",
          "title": "Agent Orchestra",
          "icon": "media/agents.svg"
        }
      ]
    },
    "views": {
      "agentOrchestra": [
        {
          "id": "agentOrchestra.files",
          "name": "Agentes e skills"
        }
      ]
    },
    "commands": [
      {
        "command": "agentOrchestra.refresh",
        "title": "Agent Orchestra: Atualizar",
        "icon": "$(refresh)"
      },
      {
        "command": "agentOrchestra.find",
        "title": "Agent Orchestra: Buscar agente ou skill",
        "icon": "$(search)"
      },
      {
        "command": "agentOrchestra.create",
        "title": "Agent Orchestra: Criar arquivo manual de agente ou skill",
        "icon": "$(add)"
      },
      {
        "command": "agentOrchestra.open",
        "title": "Agent Orchestra: Abrir para editar"
      },
      {
        "command": "agentOrchestra.preview",
        "title": "Agent Orchestra: Visualizar em leitura"
      },
      {
        "command": "agentOrchestra.reveal",
        "title": "Agent Orchestra: Mostrar no Explorer"
      },
      {
        "command": "agentOrchestra.copyPath",
        "title": "Agent Orchestra: Copiar caminho"
      },
      {
        "command": "agentOrchestra.forgeCreate",
        "title": "Agent Orchestra: Definir agente com a Forja",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentOrchestra.forgeBuild",
        "title": "Agent Orchestra: Gerar a partir da especificação",
        "icon": "$(sparkle)"
      },
      {
        "command": "agentOrchestra.dashboard",
        "title": "Agent Orchestra: Abrir painel do agente",
        "icon": "$(graph)"
      },
      {
        "command": "agentOrchestra.enableMonitoring",
        "title": "Agent Orchestra: Ativar monitoramento local"
      },
      {
        "command": "agentOrchestra.disableMonitoring",
        "title": "Agent Orchestra: Desativar monitoramento local"
      },
      {
        "command": "agentOrchestra.instructions",
        "title": "Agent Orchestra: Ler instruções do script",
        "icon": "$(book)"
      },
      {
        "command": "agentOrchestra.runScript",
        "title": "Agent Orchestra: Executar script com argumentos",
        "icon": "$(list-unordered)"
      },
      {
        "command": "agentOrchestra.runScriptQuick",
        "title": "Agent Orchestra: Executar script sem argumentos",
        "icon": "$(play)"
      },
      {
        "command": "agentOrchestra.shareAgent",
        "title": "Agent Orchestra: Compartilhar agente",
        "icon": "$(share)"
      },
      {
        "command": "agentOrchestra.importPackage",
        "title": "Agent Orchestra: Importar pacote de agente",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentOrchestra.runAgent",
        "title": "Agent Orchestra: Executar agente",
        "icon": "$(play)"
      },
      {
        "command": "agentOrchestra.agentRunInstructions",
        "title": "Agent Orchestra: Ler roteiros prontos",
        "icon": "$(book)"
      },
      {
        "command": "agentOrchestra.checkUpdates",
        "title": "Agent Orchestra: Verificar atualizações",
        "icon": "$(versions)"
      },
      {
        "command": "agentOrchestra.projectMap",
        "title": "Agent Orchestra: Mapear projeto",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "agentOrchestra.generateProjectDocs",
        "title": "Agent Orchestra: Mapear projeto e documentar com agente",
        "icon": "$(book)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentOrchestra.open",
          "when": "false"
        },
        {
          "command": "agentOrchestra.preview",
          "when": "false"
        },
        {
          "command": "agentOrchestra.reveal",
          "when": "false"
        },
        {
          "command": "agentOrchestra.copyPath",
          "when": "false"
        },
        {
          "command": "agentOrchestra.forgeBuild",
          "when": "false"
        },
        {
          "command": "agentOrchestra.dashboard",
          "when": "false"
        },
        {
          "command": "agentOrchestra.instructions",
          "when": "false"
        },
        {
          "command": "agentOrchestra.runScript",
          "when": "false"
        },
        {
          "command": "agentOrchestra.runScriptQuick",
          "when": "false"
        },
        {
          "command": "agentOrchestra.shareAgent",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "agentOrchestra.projectMap",
          "when": "view == agentOrchestra.files",
          "group": "navigation@1"
        },
        {
          "command": "agentOrchestra.generateProjectDocs",
          "when": "view == agentOrchestra.files",
          "group": "more@4"
        },
        {
          "command": "agentOrchestra.checkUpdates",
          "when": "view == agentOrchestra.files",
          "group": "navigation@2"
        },
        {
          "command": "agentOrchestra.refresh",
          "when": "view == agentOrchestra.files",
          "group": "more@1"
        },
        {
          "command": "agentOrchestra.find",
          "when": "view == agentOrchestra.files",
          "group": "more@2"
        },
        {
          "command": "agentOrchestra.create",
          "when": "view == agentOrchestra.files",
          "group": "more@3"
        },
        {
          "command": "agentOrchestra.forgeCreate",
          "when": "view == agentOrchestra.files",
          "group": "navigation@3"
        },
        {
          "command": "agentOrchestra.importPackage",
          "when": "view == agentOrchestra.files",
          "group": "more@5"
        },
        {
          "command": "agentOrchestra.runAgent",
          "when": "view == agentOrchestra.files",
          "group": "more@6"
        }
      ],
      "view/item/context": [
        {
          "command": "agentOrchestra.preview",
          "when": "view == agentOrchestra.files && (viewItem == orchestraMarkdown || viewItem == orchestraAgent || viewItem == orchestraSkill)",
          "group": "navigation@1"
        },
        {
          "command": "agentOrchestra.open",
          "when": "view == agentOrchestra.files && (viewItem == orchestraMarkdown || viewItem == orchestraConfig || viewItem == orchestraAgent || viewItem == orchestraSkill || viewItem == orchestraSpec)",
          "group": "navigation@2"
        },
        {
          "command": "agentOrchestra.reveal",
          "when": "view == agentOrchestra.files && (viewItem == orchestraMarkdown || viewItem == orchestraConfig || viewItem == orchestraAgent || viewItem == orchestraSkill || viewItem == orchestraSpec || viewItem == orchestraScript)",
          "group": "navigation@3"
        },
        {
          "command": "agentOrchestra.copyPath",
          "when": "view == agentOrchestra.files && (viewItem == orchestraMarkdown || viewItem == orchestraConfig || viewItem == orchestraAgent || viewItem == orchestraSkill || viewItem == orchestraSpec || viewItem == orchestraScript)",
          "group": "navigation@4"
        },
        {
          "command": "agentOrchestra.dashboard",
          "when": "view == agentOrchestra.files && (viewItem == orchestraAgent || viewItem == orchestraSpec)",
          "group": "inline@1"
        },
        {
          "command": "agentOrchestra.forgeBuild",
          "when": "view == agentOrchestra.files && viewItem == orchestraSpec",
          "group": "inline@0"
        },
        {
          "command": "agentOrchestra.instructions",
          "when": "view == agentOrchestra.files && viewItem == orchestraScript",
          "group": "inline@2"
        },
        {
          "command": "agentOrchestra.runScript",
          "when": "view == agentOrchestra.files && viewItem == orchestraScript",
          "group": "inline@1"
        },
        {
          "command": "agentOrchestra.runScriptQuick",
          "when": "view == agentOrchestra.files && viewItem == orchestraScript",
          "group": "inline@0"
        },
        {
          "command": "agentOrchestra.shareAgent",
          "when": "view == agentOrchestra.files && (viewItem == orchestraAgent || viewItem == orchestraSkill)",
          "group": "inline@2"
        },
        {
          "command": "agentOrchestra.runAgent",
          "when": "view == agentOrchestra.files && viewItem == orchestraAgent",
          "group": "inline@0"
        },
        {
          "command": "agentOrchestra.runAgent",
          "when": "view == agentOrchestra.files && viewItem == orchestraPreset",
          "group": "inline@0"
        },
        {
          "command": "agentOrchestra.agentRunInstructions",
          "when": "view == agentOrchestra.files && viewItem == orchestraPreset",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "Agent Orchestra",
      "properties": {
        "agentOrchestra.includeUserInstallations": {
          "type": "boolean",
          "default": true,
          "description": "Mostra agentes e skills em ~/.codex e ~/.claude, além dos projetos abertos."
        },
        "agentOrchestra.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Executável Python 3.10+ para a Forja, importação de ZIP e análise AST. Se o padrão 'python' não existir, a extensão baixa Python 3.13 para o armazenamento local."
        },
        "agentOrchestra.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Executável Node.js para o analisador integrado e scripts JavaScript."
        },
        "agentOrchestra.claudePath": {
          "type": "string",
          "default": "claude",
          "description": "Executável Claude Code para iniciar agentes no terminal integrado."
        },
        "agentOrchestra.codexPath": {
          "type": "string",
          "default": "codex",
          "description": "Executável Codex CLI para iniciar agentes no terminal integrado."
        },
        "agentOrchestra.goPath": {
          "type": "string",
          "default": "go",
          "description": "Executável Go para scripts e análise AST de Go."
        },
        "agentOrchestra.shellPath": {
          "type": "string",
          "default": "bash",
          "description": "Shell para scripts .sh de skills."
        },
        "agentOrchestra.powershellPath": {
          "type": "string",
          "default": "powershell",
          "description": "PowerShell para scripts .ps1 de skills."
        },
        "agentOrchestra.updateMode": {
          "type": "string",
          "enum": [
            "off",
            "notify",
            "auto"
          ],
          "default": "notify",
          "description": "Atualizações do VSIX: desligar, avisar ou instalar automaticamente após verificar o manifesto no site."
        },
        "agentOrchestra.updateManifestUrl": {
          "type": "string",
          "default": "https://carlosfrancog.github.io/nestor-forge-web/updates/agentorchestra.json",
          "description": "Endpoint HTTPS com a versão, URL e hash SHA-256 do VSIX publicado no site."
        },
        "agentOrchestra.vscodeCliPath": {
          "type": "string",
          "default": "auto",
          "description": "CLI do VS Code para instalar atualizações por VSIX. No Windows, auto usa a CLI incluída junto ao Code.exe; também aceita Code.exe ou bin/code.cmd."
        }
      }
    }
  },
  "dependencies": {
    "@babel/parser": "^7.29.9",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/compiler-sfc": "^3.5.44",
    "pgsql-ast-parser": "^12.0.2",
    "php-parser": "^3.7.0",
    "postcss": "^8.5.30",
    "yaml": "^2.9.1"
  }
}
